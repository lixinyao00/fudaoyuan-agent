# =============================================================
# 辅导员AI问答机器人 - 环境配置
# 复制此文件为 .env 并填入真实值
# =============================================================

# ---- 数据库 ----
# MySQL (生产环境)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/daoyuan?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8mb4&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=daoyuan
SPRING_DATASOURCE_PASSWORD=daoyuan123

# ---- AI Provider ----
# 可选值: mock (本地测试) / mimo (接入小米MiMo)
AI_PROVIDER=mimo

# ---- MiMo API ----
MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=请在此填入你的API Key
MIMO_MODEL=mimo-v2.5
MIMO_TIMEOUT=30
MIMO_MAX_TOKENS=1200

# ---- RAG 参数 ----
RAG_RETRIEVAL_TOP_K=8
RAG_EVIDENCE_TOP_N=5
RAG_MIN_SCORE=0.15

# ---- 管理员 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
